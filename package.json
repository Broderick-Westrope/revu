{
  "name": "revu",
  "displayName": "Revu",
  "description": "Guided review and local review comments for AI-assisted workflows",
  "version": "0.0.1",
  "publisher": "broderick-westrope",
  "repository": { "type": "git", "url": "https://github.com/Broderick-Westrope/revu" },
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "revu.startReview", "title": "Revu: Start Review" },
      { "command": "revu.endReview", "title": "Revu: End Review" },
      { "command": "revu.refreshPrThreads", "title": "Revu: Refresh PR Threads" },
      { "command": "revu.openDiff", "title": "Revu: Open Diff" },
      { "command": "revu.generateGuide", "title": "Revu: Generate Review Guide", "icon": "$(sparkle)" },
      { "command": "revu.openGuide", "title": "Revu: Open Review Guide", "icon": "$(open-preview)" },
      { "command": "revu.createComment", "title": "Add Local Comment" },
      { "command": "revu.deleteComment", "title": "Delete" },
      { "command": "revu.clearAllComments", "title": "Revu: Clear All Comments" },
      { "command": "revu.copyAllComments", "title": "Revu: Copy All Comments as Markdown" },
      { "command": "revu.copyComment", "title": "Copy as Markdown" },
      { "command": "revu.quoteComment", "title": "Quote in local comment" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "revu", "title": "Revu", "icon": "media/revu.svg" }
      ]
    },
    "views": {
      "revu": [
        { "id": "revu.guideView", "name": "Review Guide" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "revu.guideView",
        "contents": "Start a review to begin.\n[Start Review](command:revu.startReview)",
        "when": "!revu.reviewActive"
      },
      {
        "view": "revu.guideView",
        "contents": "No guide yet for this review.\n[Generate a Guide](command:revu.generateGuide)",
        "when": "revu.reviewActive"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "revu.generateGuide",
          "group": "navigation",
          "when": "view == revu.guideView"
        },
        {
          "command": "revu.openGuide",
          "group": "navigation",
          "when": "view == revu.guideView"
        },
        {
          "command": "revu.startReview",
          "when": "view == revu.guideView"
        }
      ],
      "commandPalette": [
        { "command": "revu.createComment", "when": "false" },
        { "command": "revu.deleteComment", "when": "false" },
        { "command": "revu.copyComment", "when": "false" },
        { "command": "revu.quoteComment", "when": "false" }
      ],
      "comments/comment/title": [
        {
          "command": "revu.quoteComment",
          "group": "navigation",
          "when": "commentController == revu-github"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "revu.createComment",
          "group": "inline",
          "when": "commentController == revu-local"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "revu.copyComment",
          "group": "navigation",
          "when": "commentThread == revuLocal"
        },
        {
          "command": "revu.deleteComment",
          "group": "navigation",
          "when": "commentThread == revuLocal"
        }
      ]
    },
    "configuration": {
      "title": "Revu",
      "properties": {
        "revu.agentCommand": {
          "type": "string",
          "default": "claude -p",
          "description": "Agent CLI command used for guide generation. Receives the prompt on stdin. Split on whitespace; executable paths containing spaces are not supported — use a wrapper script."
        },
        "revu.agentTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Minimum timeout for guide generation; the effective timeout scales up with prompt size."
        },
        "revu.agentTimeoutMaxSeconds": {
          "type": "number",
          "default": 600,
          "description": "Upper bound for the size-scaled guide generation timeout."
        },
        "revu.autoMarkRead": {
          "type": "boolean",
          "default": false,
          "description": "Automatically mark a guide file as read when opened from the guide."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "pretest": "tsc -p tsconfig.test.json && node esbuild.mjs",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
