{
  "name": "revu",
  "displayName": "Revu",
  "description": "Branch-aware review and local review comments for AI-assisted workflows",
  "version": "0.0.1",
  "publisher": "broderick-westrope",
  "repository": {
    "type": "git",
    "url": "https://github.com/Broderick-Westrope/revu"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "revu.refreshPrThreads",
        "title": "Revu: Refresh PR Threads"
      },
      {
        "command": "revu.createComment",
        "title": "Add Local Comment"
      },
      {
        "command": "revu.deleteComment",
        "title": "Delete"
      },
      {
        "command": "revu.clearAllComments",
        "title": "Revu: Clear All Comments"
      },
      {
        "command": "revu.copyAllComments",
        "title": "Revu: Copy All Comments as Markdown"
      },
      {
        "command": "revu.copyComment",
        "title": "Copy as Markdown"
      },
      {
        "command": "revu.quoteComment",
        "title": "Quote in local comment"
      },
      {
        "command": "revu.refreshCheckpoint",
        "title": "Revu: Refresh Checkpoint View",
        "icon": "$(refresh)"
      },
      {
        "command": "revu.markSafe",
        "title": "Mark Safe",
        "icon": "$(check)"
      },
      {
        "command": "revu.moveCheckpoint",
        "title": "Move Checkpoint Here",
        "icon": "$(discard)"
      },
      {
        "command": "revu.setCheckpoint",
        "title": "Revu: Set Checkpoint"
      },
      {
        "command": "revu.removeCheckpoint",
        "title": "Revu: Remove Checkpoint"
      },
      {
        "command": "revu.compareWithWorkingTree",
        "title": "Revu: Compare with Working Tree",
        "icon": "$(edit)"
      },
      {
        "command": "revu.refreshStack",
        "title": "Revu: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "revu.showSinceCheckpoint",
        "title": "Revu: Show Changes Since Checkpoint",
        "icon": "$(milestone)"
      },
      {
        "command": "revu.showAllChanges",
        "title": "Revu: Show All Branch Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "revu.openChangesFile",
        "title": "Open Diff"
      },
      {
        "command": "revu.switchToBranch",
        "title": "Switch",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "revu.openBranchInNewWindow",
        "title": "Open in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "revu.openPr",
        "title": "Open PR",
        "icon": "$(github)"
      },
      {
        "command": "revu.pullDefaultBranch",
        "title": "Revu: Pull Default Branch",
        "icon": "$(repo-pull)"
      },
      {
        "command": "revu.mergeParent",
        "title": "Revu: Merge Parent",
        "icon": "$(git-merge)"
      },
      {
        "command": "revu.compareWith",
        "title": "Revu: Compare With…"
      },
      {
        "command": "revu.resetParent",
        "title": "Revu: Reset Parent"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "revu",
          "title": "Revu",
          "icon": "media/revu.svg"
        }
      ]
    },
    "views": {
      "revu": [
        {
          "id": "revu.stackView",
          "name": "Stack"
        },
        {
          "id": "revu.changesView",
          "name": "Changes"
        },
        {
          "id": "revu.checkpointView",
          "name": "Checkpoint"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "revu.stackView",
        "contents": "Open a git repository to see its stack.",
        "when": "!revu.isGitRepo"
      },
      {
        "view": "revu.changesView",
        "contents": "Open a git repository to review its branch.",
        "when": "!revu.isGitRepo"
      },
      {
        "view": "revu.checkpointView",
        "contents": "Open a git repository to use checkpoints.",
        "when": "!revu.isGitRepo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "revu.pullDefaultBranch",
          "group": "navigation@1",
          "when": "view == revu.stackView"
        },
        {
          "command": "revu.mergeParent",
          "group": "navigation@2",
          "when": "view == revu.stackView && revu.onFeatureBranch && !revu.inGhStack"
        },
        {
          "command": "revu.refreshStack",
          "group": "navigation@3",
          "when": "view == revu.stackView"
        },
        {
          "command": "revu.showSinceCheckpoint",
          "group": "navigation",
          "when": "view == revu.changesView && !revu.checkpointMode"
        },
        {
          "command": "revu.showAllChanges",
          "group": "navigation",
          "when": "view == revu.changesView && revu.checkpointMode"
        },
        {
          "command": "revu.refreshStack",
          "group": "navigation",
          "when": "view == revu.changesView"
        },
        {
          "command": "revu.refreshCheckpoint",
          "group": "navigation",
          "when": "view == revu.checkpointView"
        },
        {
          "command": "revu.compareWith",
          "group": "1_parent@1",
          "when": "view == revu.changesView && revu.onFeatureBranch"
        },
        {
          "command": "revu.resetParent",
          "group": "1_parent@2",
          "when": "view == revu.changesView && revu.hasParentOverride"
        }
      ],
      "view/item/context": [
        {
          "command": "revu.switchToBranch",
          "group": "inline@1",
          "when": "view == revu.stackView && viewItem =~ /;switch\\b/"
        },
        {
          "command": "revu.openBranchInNewWindow",
          "group": "inline@2",
          "when": "view == revu.stackView && viewItem =~ /;worktree\\b/"
        },
        {
          "command": "revu.openPr",
          "group": "inline@3",
          "when": "view == revu.stackView && viewItem =~ /;pr\\b/"
        },
        {
          "command": "revu.markSafe",
          "group": "inline",
          "when": "view == revu.checkpointView && viewItem == revu.commit"
        },
        {
          "command": "revu.moveCheckpoint",
          "group": "inline",
          "when": "view == revu.checkpointView && viewItem == revu.reviewedCommit"
        },
        {
          "command": "revu.compareWithWorkingTree",
          "when": "view == revu.checkpointView && viewItem == revu.commitFile"
        }
      ],
      "editor/title": [
        {
          "command": "revu.compareWithWorkingTree",
          "group": "navigation",
          "when": "resourceScheme == revu-git"
        }
      ],
      "commandPalette": [
        {
          "command": "revu.createComment",
          "when": "false"
        },
        {
          "command": "revu.deleteComment",
          "when": "false"
        },
        {
          "command": "revu.copyComment",
          "when": "false"
        },
        {
          "command": "revu.quoteComment",
          "when": "false"
        },
        {
          "command": "revu.markSafe",
          "when": "false"
        },
        {
          "command": "revu.moveCheckpoint",
          "when": "false"
        },
        {
          "command": "revu.openChangesFile",
          "when": "false"
        },
        {
          "command": "revu.switchToBranch",
          "when": "false"
        },
        {
          "command": "revu.openBranchInNewWindow",
          "when": "false"
        },
        {
          "command": "revu.openPr",
          "when": "false"
        },
        {
          "command": "revu.mergeParent",
          "when": "revu.onFeatureBranch && !revu.inGhStack"
        },
        {
          "command": "revu.compareWith",
          "when": "revu.onFeatureBranch"
        },
        {
          "command": "revu.resetParent",
          "when": "revu.hasParentOverride"
        }
      ],
      "comments/comment/title": [
        {
          "command": "revu.quoteComment",
          "group": "navigation",
          "when": "commentController == revu-github"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "revu.createComment",
          "group": "inline",
          "when": "commentController == revu-local"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "revu.copyComment",
          "group": "navigation",
          "when": "commentThread == revuLocal"
        },
        {
          "command": "revu.deleteComment",
          "group": "navigation",
          "when": "commentThread == revuLocal"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "pretest": "tsc -p tsconfig.test.json && node esbuild.mjs",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies -o revu.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
